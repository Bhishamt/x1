# Web App — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local

# Supabase (get from: supabase.com → Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# ⚠️  SERVICE ROLE KEY — server-side only, never expose to browser
# get from: supabase.com → Project → Settings → API → Service Role
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Groq API (for chatbot — get from: console.groq.com/keys)
GROQ_API_KEY=gsk_...your_key_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COLLEGE_NAME=ABC Polytechnic
